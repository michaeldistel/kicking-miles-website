{
  "name": "kickingmiles-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "cf:deploy": "pnpm prod:build && cf pages deploy build --project-name=kickingmiles-website --branch=main --commit-dirty=true",
    "prod:build": "pnpm prebuild && pnpm build",
    "prebuild": "node scripts/generate-build-info.cjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.1.1",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.31.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.2",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.36",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.2",
    "svelte": "^5.38.1",
    "svelte-check": "^3.6.7",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vite": "^7.1.2"
  },
  "type": "module",
  "dependencies": {
    "photoswipe": "^5.4.4"
  }
}
